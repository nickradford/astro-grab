---
// ShortcutDisplay component - displays platform-aware keyboard shortcuts
---

<span class="shortcut-display">Cmd/Ctrl+G</span>

<script>
  import { onShortcutChange } from "../utils/astro-grab-shortcut.js";

  const updateShortcuts = (shortcutLabel: string): void => {
    const shortcutElements = document.querySelectorAll(".shortcut-display");

    shortcutElements.forEach((element) => {
      element.textContent = shortcutLabel;
    });
  };

  const cleanupShortcutChange = onShortcutChange(updateShortcuts);

  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      cleanupShortcutChange();
    });
  }
</script>
