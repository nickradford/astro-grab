---
// ProgressBar.astro - Visual feedback during Cmd/Ctrl+G hold
---

<!-- Progress bar above walkthrough steps -->
<div
  id="hold-progress-bar"
  class="mx-auto mb-4 max-w-lg"
  style="display: none;"
>
  <div class="h-2 overflow-hidden rounded-full bg-gray-800/50">
    <div
      id="hold-progress-fill"
      class="h-full transition-all"
      style="width: 0%; background: linear-gradient(to right, #ff8c00, #ffa500); transition-property: width; transition-timing-function: linear;"
    >
    </div>
  </div>
  <p class="mt-1 text-center text-xs text-gray-400">
    Hold <span id="hold-shortcut-display">Cmd/Ctrl+G</span>...
  </p>
</div>

<script>
  import { onShortcutChange } from "../utils/astro-grab-shortcut.js";

  const HOLD_DURATION = 1000; // Match default holdDuration
  const holdShortcutDisplay = document.getElementById("hold-shortcut-display");

  const handleShortcutChange = (shortcutLabel) => {
    if (holdShortcutDisplay instanceof HTMLElement) {
      holdShortcutDisplay.textContent = shortcutLabel;
    }
  };

  const handleKeyHeld = () => {
    const progressBar = document.getElementById("hold-progress-bar");
    const progressFill = document.getElementById("hold-progress-fill");

    if (!progressBar || !progressFill) return;

    // Reset and show progress bar
    progressBar.style.display = "block";
    progressFill.style.width = "0%";
    progressFill.style.transitionDuration = `${HOLD_DURATION}ms`;

    // Force reflow to restart animation
    progressFill.offsetHeight;

    // Start the fill animation
    requestAnimationFrame(() => {
      progressFill.style.width = "100%";
    });
  };

  const handleTargetingModeStarted = () => {
    const progressBar = document.getElementById("hold-progress-bar");
    const progressFill = document.getElementById("hold-progress-fill");

    if (!progressBar || !progressFill) return;

    setTimeout(() => {
      progressBar.style.display = "none";
      progressFill.style.width = "0%";
    }, 200);
  };

  const handleKeypressTooShort = () => {
    const progressBar = document.getElementById("hold-progress-bar");
    const progressFill = document.getElementById("hold-progress-fill");

    if (!progressBar || !progressFill) return;

    // Flash red to indicate early release
    progressFill.style.background = "#ef4444";
    progressFill.style.width = "0%";
    setTimeout(() => {
      progressBar.style.display = "none";
      progressFill.style.background =
        "linear-gradient(to right, #ff8c00, #ffa500)";
    }, 300);
  };

  const cleanupShortcutChange = onShortcutChange(handleShortcutChange);

  window.addEventListener("astro-grab:key-held", handleKeyHeld);
  window.addEventListener(
    "astro-grab:targeting-mode-started",
    handleTargetingModeStarted,
  );
  window.addEventListener(
    "astro-grab:keypress-too-short",
    handleKeypressTooShort,
  );

  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      cleanupShortcutChange();
      window.removeEventListener("astro-grab:key-held", handleKeyHeld);
      window.removeEventListener(
        "astro-grab:targeting-mode-started",
        handleTargetingModeStarted,
      );
      window.removeEventListener(
        "astro-grab:keypress-too-short",
        handleKeypressTooShort,
      );
    });
  }
</script>
